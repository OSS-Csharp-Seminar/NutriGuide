@page "/history"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits RequireProfile
@using NutriGuide.Application.DTOs.MealLog
@using NutriGuide.Application.Interfaces
@inject IMealLogService MealLogService
@using NutriGuide.Application.DTOs.Wellness
@inject IWellnessService WellnessService

<PageTitle>History</PageTitle>

<h1>History</h1>
<p class="text-muted">Browse what you've logged on any day. Days with meals are marked.</p>

@if (!ProfileReady)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="history-shell">
        <section class="history-panel history-calendar-panel">
            <div class="history-panel-heading">
                <div>
                    <span class="eyebrow">Calendar</span>
                    <h2>@currentMonth.ToString("MMMM yyyy")</h2>
                </div>
                <div class="history-month-controls">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PrevMonth">‹</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NextMonth">›</button>
                </div>
            </div>

            <div class="calendar-grid">
                @foreach (var dayName in new[] { "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su" })
                {
                    <div class="calendar-head">@dayName</div>
                }

                @for (var i = 0; i < leadingBlanks; i++)
                {
                    <div></div>
                }

                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var date = new DateOnly(currentMonth.Year, currentMonth.Month, day);
                    var hasMeals = loggedDates.Contains(date);
                    var isSelected = date == selectedDate;
                    var isFuture = date > DateOnly.FromDateTime(DateTime.UtcNow);

                    <button class="calendar-day @(isSelected ? "selected" : "") @(hasMeals ? "has-meals" : "")"
                            disabled="@isFuture"
                            @onclick="() => SelectDate(date)">
                        @day
                    </button>
                }
            </div>
        </section>

        <section class="history-panel history-detail-panel">
            @if (selectedDate is null)
            {
                <div class="history-empty-state">
                    <span class="eyebrow">Daily view</span>
                    <h2>Select a day</h2>
                    <p>Pick a calendar date to see meals and wellness notes together.</p>
                </div>
            }
            else if (daySummary is null)
            {
                <p><em>Loading…</em></p>
            }
            else
            {
                <div class="history-panel-heading table-heading">
                    <div>
                        <span class="eyebrow">Daily view</span>
                        <h2>@selectedDate.Value.ToString("dddd, d MMMM yyyy")</h2>
                    </div>
                    <span class="status-pill @(daySummary.Meals.Count > 0 ? "success" : "")">
                        @daySummary.Meals.Count meals
                    </span>
                </div>

                <div class="history-detail-scroll">
                    @if (daySummary.Meals.Count == 0)
                    {
                        <div class="empty-meals history-empty-state">
                            <strong>Nothing logged on this day.</strong>
                            <span>Choose another marked day or log something new from the Log meal tab.</span>
                        </div>
                    }
                    else
                    {
                        <section class="history-inner-panel history-macros-panel">
                            <div class="history-section-title">
                                <span class="eyebrow">Nutrition</span>
                                <h3>Daily totals</h3>
                            </div>
                            <div class="history-macro-strip">
                                <div><span>@daySummary.TotalCalories</span><small>kcal</small></div>
                                <div><span>@daySummary.TotalProtein_g g</span><small>protein</small></div>
                                <div><span>@daySummary.TotalCarbs_g g</span><small>carbs</small></div>
                                <div><span>@daySummary.TotalFat_g g</span><small>fat</small></div>
                                <div><span>@daySummary.TotalFiber_g g</span><small>fiber</small></div>
                            </div>
                        </section>

                        <section class="history-inner-panel history-meals-panel">
                            <div class="history-section-title">
                                <span class="eyebrow">Meals</span>
                                <h3>What you logged</h3>
                            </div>
                            <div class="table-responsive history-meals-scroll">
                                <table class="table history-meal-table">
                                    <thead>
                                        <tr><th>Meal</th><th>Calories</th><th>Protein</th><th>Carbs</th><th>Fat</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var meal in daySummary.Meals)
                                        {
                                            <tr>
                                                <td><strong>@meal.RawInput</strong></td>
                                                <td>@meal.Calories</td>
                                                <td>@meal.Protein_g g</td>
                                                <td>@meal.Carbs_g g</td>
                                                <td>@meal.Fat_g g</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }

                    @if (SelectedDayWellness.Count > 0)
                    {
                        <section class="history-inner-panel history-wellness-block">
                            <div class="history-section-title">
                                <span class="eyebrow">Wellness</span>
                                <h3>Wellness notes</h3>
                            </div>

                            <div class="history-wellness-scroll">
                                @foreach (var w in SelectedDayWellness)
                                {
                                    <article class="history-wellness-entry">
                                        <div class="text-muted small">@w.LoggedAt.ToString("HH:mm")</div>
                                        <div class="history-wellness-symptoms">@w.Symptoms</div>
                                        @if (!string.IsNullOrWhiteSpace(w.AiAnalysis))
                                        {
                                            <div class="small mt-2">@w.AiAnalysis</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(w.SuggestedMeal))
                                        {
                                            <div class="small text-success mt-2">Suggested: @w.SuggestedMeal</div>
                                        }
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private DateOnly currentMonth = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly? selectedDate;
    private DailyMealSummaryDto? daySummary;
    private HashSet<DateOnly> loggedDates = new();
    private List<WellnessLogDto> wellnessEntries = new();

    private int daysInMonth => DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
    private int leadingBlanks =>
        ((int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek + 6) % 7; // Monday-first
    private List<WellnessLogDto> SelectedDayWellness =>
        selectedDate is null
            ? new()
            : wellnessEntries
                .Where(w => DateOnly.FromDateTime(w.LoggedAt) == selectedDate.Value)
                .ToList();

    protected override async Task OnProfileReadyAsync()
    {
        if (UserId is not null)
            wellnessEntries = await WellnessService.GetHistoryAsync(UserId);
        await LoadMonthAsync();
    }

    private async Task LoadMonthAsync()
    {
        if (UserId is null) return;
        var first = currentMonth;
        var last = new DateOnly(currentMonth.Year, currentMonth.Month, daysInMonth);
        loggedDates = await MealLogService.GetLoggedDatesAsync(UserId, first, last);
    }

    private async Task PrevMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadMonthAsync();
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadMonthAsync();
    }

    private async Task SelectDate(DateOnly date)
    {
        if (UserId is null) return;
        selectedDate = date;
        daySummary = null;
        daySummary = await MealLogService.GetByDateAsync(UserId, date);
    }
}
