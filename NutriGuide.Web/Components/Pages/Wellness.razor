@page "/wellness"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits RequireProfile
@using NutriGuide.Application.DTOs.Wellness
@using NutriGuide.Application.Interfaces
@inject IWellnessService WellnessService

<PageTitle>How do you feel?</PageTitle>

<h1>How do you feel?</h1>
<p class="text-muted">
    Describe how you're feeling — tired, bloated, low energy — and the AI will look at your
    last 48 hours of meals and suggest something that might help.
</p>

<p class="text-muted small fst-italic">
    AI suggestions are general guidance based on your logged meals — not medical advice.
    If symptoms persist or worsen, talk to a healthcare professional.
</p>

@if (!ProfileReady)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="wellness-shell">
        <div class="wellness-main">
            <section class="wellness-panel wellness-entry-panel">
                <div class="wellness-panel-heading">
                    <div>
                        <span class="eyebrow">Check-in</span>
                        <h2>Tell NutriGuide what's going on</h2>
                    </div>
                    <span class="status-pill attention">48h meal context</span>
                </div>

                <textarea class="form-control wellness-textarea"
                          rows="5"
                          placeholder="e.g. I've felt tired and a bit bloated since yesterday afternoon"
                          @bind="symptoms" @bind:event="oninput" disabled="@isBusy"></textarea>

                <div class="wellness-actions">
                    <button class="btn btn-primary"
                            @onclick="Analyze"
                            disabled="@(isBusy || string.IsNullOrWhiteSpace(symptoms))">
                        @(isBusy ? "Analyzing…" : "Analyze how I feel")
                    </button>
                    <span class="small text-muted">Use symptoms, energy, digestion, sleep, or mood.</span>
                </div>

                @if (error is not null)
                {
                    <div class="text-danger mt-2">@error</div>
                }
            </section>

            @if (latest is not null)
            {
                <section class="wellness-panel wellness-result-panel">
                    <div class="wellness-panel-heading compact">
                        <span class="eyebrow">Latest insight</span>
                        <h2>What the AI thinks</h2>
                    </div>
                    <p>@latest.AiAnalysis</p>
                    @if (!string.IsNullOrWhiteSpace(latest.SuggestedMeal))
                    {
                        <div class="alert alert-success mb-0">
                            <strong>Suggested meal:</strong> @latest.SuggestedMeal
                        </div>
                    }
                </section>
            }

            <section class="wellness-panel wellness-guide-panel">
                <div class="wellness-panel-heading compact">
                    <span class="eyebrow">Useful prompts</span>
                    <h2>What to include</h2>
                </div>
                <div class="wellness-prompt-grid">
                    <div>
                        <strong>Energy</strong>
                        <span>Tired, restless, focused, sleepy.</span>
                    </div>
                    <div>
                        <strong>Digestion</strong>
                        <span>Bloating, hunger, cravings, heaviness.</span>
                    </div>
                    <div>
                        <strong>Timing</strong>
                        <span>When it started and what changed.</span>
                    </div>
                </div>
            </section>
        </div>

        <aside class="wellness-panel wellness-history-panel">
            <div class="wellness-panel-heading table-heading">
                <div>
                    <span class="eyebrow">Timeline</span>
                    <h2>Wellness journal</h2>
                </div>
                <span class="status-pill">@history.Count entries</span>
            </div>

            @if (history.Count == 0)
            {
                <div class="empty-meals wellness-empty-state">
                    <strong>No wellness entries yet.</strong>
                    <span>Your check-ins will appear here after the AI analyzes them.</span>
                </div>
            }
            else
            {
                <div class="wellness-history-scroll">
                    @foreach (var entry in history)
                    {
                        <article class="wellness-history-entry">
                            <div class="text-muted small">@entry.LoggedAt.ToString("dddd, d MMMM yyyy · HH:mm")</div>
                            <div class="wellness-entry-symptoms">@entry.Symptoms</div>
                            @if (!string.IsNullOrWhiteSpace(entry.AiAnalysis))
                            {
                                <div class="small mt-2">@entry.AiAnalysis</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.SuggestedMeal))
                            {
                                <div class="small text-success mt-2">Suggested: @entry.SuggestedMeal</div>
                            }
                        </article>
                    }
                </div>
            }
        </aside>
    </div>
}

@code {
    private string symptoms = string.Empty;
    private WellnessLogDto? latest;
    private List<WellnessLogDto> history = new();
    private bool isBusy;
    private string? error;

    protected override async Task OnProfileReadyAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (UserId is null) return;
        history = await WellnessService.GetHistoryAsync(UserId);
    }

    private async Task Analyze()
    {
        if (UserId is null || string.IsNullOrWhiteSpace(symptoms) || isBusy) return;
        isBusy = true;
        error = null;
        try
        {
            latest = await WellnessService.CreateAsync(UserId, new CreateWellnessLogDto
            {
                Symptoms = symptoms.Trim()
            });
            symptoms = string.Empty;
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
