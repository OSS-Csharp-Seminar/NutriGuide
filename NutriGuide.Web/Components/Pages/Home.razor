@page "/"
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Welcome, @context.User.Identity?.Name 👋</h1>
        <p>You're logged in as @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
        <form method="post" action="/Account/logout">
            <AntiforgeryToken />
            <button class="btn btn-secondary" type="submit">Log out</button>
        </form>
    </Authorized>
</AuthorizeView>