@page "/weekly"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits RequireProfile
@using NutriGuide.Application.DTOs.WeeklyReport
@using NutriGuide.Application.Interfaces
@inject IWeeklyReportService ReportService

<PageTitle>Weekly report</PageTitle>

<h1>Weekly report</h1>
<p class="text-muted">A summary of how your week is going against your targets.</p>

@if (!ProfileReady || report is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="weekly-shell">
        <section class="weekly-panel weekly-hero-panel">
            <div class="weekly-panel-heading">
                <div>
                    <span class="eyebrow">Report window</span>
                    <h2>@report.WeekStart.ToString("d MMM") - @report.WeekEnd.ToString("d MMM yyyy")</h2>
                </div>
                <div class="weekly-controls">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PrevWeek">‹ Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NextWeek" disabled="@IsCurrentWeek">Next ›</button>
                </div>
            </div>

            <div class="weekly-kpi-row">
                <div>
                    <span>@report.DaysLogged</span>
                    <small>days logged</small>
                </div>
                <div>
                    <span>@report.CalorieAdherence_pct%</span>
                    <small>calorie target</small>
                </div>
                <div>
                    <span>@report.AvgCalories</span>
                    <small>avg kcal/day</small>
                </div>
            </div>
        </section>

        <section class="weekly-panel weekly-summary-panel">
            <div class="weekly-panel-heading compact">
                <span class="eyebrow">AI overview</span>
                <h2>Weekly summary</h2>
            </div>
            @if (summary is null)
            {
                <p>Get a short overview of the week based on meals, targets, and progress signals.</p>
                <button class="btn btn-outline-primary btn-sm"
                        @onclick="GenerateSummary" disabled="@isSummarizing">
                    @(isSummarizing ? "Writing…" : "Generate summary")
                </button>
            }
            else
            {
                <p>@summary</p>
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="GenerateSummary" disabled="@isSummarizing">
                    @(isSummarizing ? "Writing…" : "Regenerate")
                </button>
            }
            @if (summaryError is not null)
            {
                <div class="text-danger small mt-2">@summaryError</div>
            }
        </section>

        @if (report.DaysLogged == 0)
        {
            <section class="weekly-panel">
                <div class="empty-meals">
                    <strong>No meals logged this week.</strong>
                    <span>Log meals through the week to unlock averages and adherence.</span>
                </div>
            </section>
        }
        else
        {
            <section class="weekly-panel weekly-averages-panel">
                <div class="weekly-panel-heading compact">
                    <span class="eyebrow">Nutrition</span>
                    <h2>Daily averages</h2>
                </div>
                <div class="weekly-macro-grid">
                    <div><span>@report.AvgCalories</span><small>kcal</small></div>
                    <div><span>@report.AvgProtein_g g</span><small>protein</small></div>
                    <div><span>@report.AvgCarbs_g g</span><small>carbs</small></div>
                    <div><span>@report.AvgFat_g g</span><small>fat</small></div>
                    <div><span>@report.AvgFiber_g g</span><small>fiber</small></div>
                </div>
            </section>

            @if (report.TargetCalories > 0)
            {
                <section class="weekly-panel weekly-adherence-panel">
                    <div class="weekly-panel-heading">
                        <div>
                            <span class="eyebrow">Calories</span>
                            <h2>Adherence</h2>
                        </div>
                        <span class="status-pill @(report.CalorieAdherence_pct > 110 ? "attention" : "success")">
                            @report.CalorieAdherence_pct%
                        </span>
                    </div>
                    <p>
                        You averaged <strong>@report.AvgCalories</strong> kcal/day against a target of
                        <strong>@report.TargetCalories</strong> kcal.
                    </p>
                    <div class="weekly-adherence-track">
                        <span class="@(report.CalorieAdherence_pct > 110 ? "attention" : "")"
                              style="width: @(Math.Min(100, report.CalorieAdherence_pct))%;"></span>
                    </div>
                </section>
            }
        }
    </div>
}

@code {
    private WeeklyReportDto? report;
    private DateOnly anchorDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string? summary;
    private bool isSummarizing;
    private string? summaryError;

    private bool IsCurrentWeek =>
        anchorDate >= DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-6);

    protected override async Task OnProfileReadyAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (UserId is null) return;
        report = await ReportService.GetWeekAsync(UserId, anchorDate);
    }

    private async Task PrevWeek()
    {
        anchorDate = anchorDate.AddDays(-7);
        summary = null;
        await LoadAsync();
    }

    private async Task NextWeek()
    {
        anchorDate = anchorDate.AddDays(7);
        if (anchorDate > DateOnly.FromDateTime(DateTime.UtcNow))
            anchorDate = DateOnly.FromDateTime(DateTime.UtcNow);
        summary = null;
        await LoadAsync();
    }

    private async Task GenerateSummary()
    {
        if (UserId is null || isSummarizing) return;
        isSummarizing = true;
        summaryError = null;
        try
        {
            summary = await ReportService.GenerateSummaryAsync(UserId, anchorDate);
        }
        catch (Exception ex) { summaryError = ex.Message; }
        finally { isSummarizing = false; }
    }
}
